{
  "name": "fleetflow-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FleetFlow web client: customer, operations and driver interfaces",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build --force && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build --force",
    "lint": "eslint . --ext .vue,.ts,.tsx,.js,.jsx --max-warnings 0"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "leaflet": "^1.9.4",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.31.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  }
}
