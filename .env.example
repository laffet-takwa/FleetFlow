# Copy to .env and adjust. Nothing here is a real credential: these defaults exist so
# `docker compose up` works on a fresh clone. Set real values before any deployment.

# ------------------------------------------------------------------ datastores
POSTGRES_ADMIN_USER=fleetflow
POSTGRES_PORT=5432
DB_PASSWORD=fleetflow
MONGODB_PORT=27017
REDIS_PORT=6379
KAFKA_PORT=29092

# --------------------------------------------------------------------- secrets
# Both values must be overridden outside local development.
#   openssl rand -base64 48
JWT_SECRET=fleetflow-local-development-secret-key-change-me-0123456789
FLEETFLOW_INTERNAL_TOKEN=fleetflow-local-internal-token

# ------------------------------------------------------------------- services
GATEWAY_PORT=8080
AUTH_PORT=8081
CUSTOMER_PORT=8082
ORDER_PORT=8083
WAREHOUSE_PORT=8084
DELIVERY_PORT=8085
TRACKING_PORT=8086
NOTIFICATION_PORT=8087
FRONTEND_PORT=8088
DISCOVERY_PORT=8761

# ----------------------------------------------------------------- observability
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
LOGSTASH_BEATS_PORT=5044

# ----------------------------------------------------------------- application
# Comma separated list of browser origins allowed to call the gateway.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8088
# Set to false to start with an empty database and no demo accounts.
SEED_ENABLED=true
LOG_LEVEL_COM_FLEETFLOW=INFO
